# ── csctf LLM Configuration ──────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For --llm mode, csctf sends the page HTML to an LLM
# to extract conversation turns instead of parsing the DOM.

# OpenAI-compatible API key (required for --llm)
# Also configurable via --llm-api-key
LLM_API_KEY=sk-your-key-here

# API base URL (default: https://api.openai.com/v1)
# Only set the base URL, do NOT include /chat/completions.
# Also configurable via --llm-base-url
# Examples:
#   OpenAI:        https://api.openai.com/v1
#   DeepSeek:       https://api.deepseek.com
#   Kimi (Moonshot): https://api.moonshot.cn/v1
# LLM_BASE_URL=https://api.openai.com/v1

# Model name (default: gpt-4o-mini)
# Also configurable via --llm-model
# LLM_MODEL=gpt-4o-mini
